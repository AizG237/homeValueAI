# URL du backend pour le proxy Vite (dev). Laisser vide pour http://localhost:8000
VITE_BACKEND_URL=http://localhost:8000

# Base d'API utilisée par fetch côté client. Vide = utilise le proxy Vite (/api).
VITE_API_URL=

# Mettre "true" pour utiliser le mock local sans backend (démo hors-ligne).
VITE_USE_MOCK=false
